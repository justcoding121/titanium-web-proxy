{
  "version": 2,
  "ruleset_id": 24311415,
  "note": "develop has no required checks by design (direct push allowed); beta and stable are enforced by ruleset release-lines.",
  "branches": {
    "develop": {
      "enforced": false,
      "advisory": [
        "merge-gate",
        "gitleaks",
        "dependency-review",
        "tests-or-waiver",
        "guard-nc-paths",
        "cla"
      ]
    },
    "beta": {
      "contexts": [
        "merge-gate",
        "rps (ubuntu-latest)",
        "rps (windows-latest)",
        "rps (macos-15)",
        "gitleaks",
        "dependency-review",
        "tests-or-waiver",
        "guard-nc-paths",
        "cla"
      ]
    },
    "stable": {
      "contexts": [
        "merge-gate",
        "rps (ubuntu-latest)",
        "rps (windows-latest)",
        "rps (macos-15)",
        "gitleaks",
        "dependency-review",
        "tests-or-waiver",
        "guard-nc-paths",
        "cla"
      ]
    }
  }
}
