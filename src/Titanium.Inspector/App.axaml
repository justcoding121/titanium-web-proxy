<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Titanium.Inspector.Converters"
             x:Class="Titanium.Inspector.App"
             Name="Titanium Inspector"
             RequestedThemeVariant="Default">
  <!-- Must be set here (before Avalonia exports the app menu). Late SetMenu cannot
       replace the default "About Avalonia" item already pushed to AppKit. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="About Titanium Inspector…" Click="OnMacAboutClick" />
    </NativeMenu>
  </NativeMenu.Menu>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SessionStatusSuccessBrush" Color="#0A5F0A" />
          <SolidColorBrush x:Key="SessionStatusRedirectBrush" Color="#0078D4" />
          <SolidColorBrush x:Key="SessionStatusClientErrorBrush" Color="#9A6700" />
          <SolidColorBrush x:Key="SessionStatusServerErrorBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="SessionStatusMutedBrush" Color="#6B6B6B" />
          <SolidColorBrush x:Key="StatusFeedbackNeutralBrush" Color="#6B6B6B" />
          <SolidColorBrush x:Key="StatusFeedbackBusyBrush" Color="#0078D4" />
          <SolidColorBrush x:Key="StatusFeedbackSuccessBrush" Color="#0A5F0A" />
          <SolidColorBrush x:Key="StatusFeedbackWarningBrush" Color="#9A6700" />
          <SolidColorBrush x:Key="StatusFeedbackErrorBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="InspectorLinkBrush" Color="#0066CC" />
          <SolidColorBrush x:Key="InspectorErrorTextBrush" Color="#C0392B" />
          <SolidColorBrush x:Key="SessionGridSelectionBrush" Color="#90C0E0" />
          <SolidColorBrush x:Key="SessionGridSelectionForegroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="SessionGridHoverBrush" Color="#F3F3F3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SessionStatusSuccessBrush" Color="#8ADB7A" />
          <SolidColorBrush x:Key="SessionStatusRedirectBrush" Color="#4CC2FF" />
          <SolidColorBrush x:Key="SessionStatusClientErrorBrush" Color="#FCE100" />
          <SolidColorBrush x:Key="SessionStatusServerErrorBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="SessionStatusMutedBrush" Color="#A0A0A0" />
          <SolidColorBrush x:Key="StatusFeedbackNeutralBrush" Color="#A0A0A0" />
          <SolidColorBrush x:Key="StatusFeedbackBusyBrush" Color="#4CC2FF" />
          <SolidColorBrush x:Key="StatusFeedbackSuccessBrush" Color="#8ADB7A" />
          <SolidColorBrush x:Key="StatusFeedbackWarningBrush" Color="#E8B96A" />
          <SolidColorBrush x:Key="StatusFeedbackErrorBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="InspectorLinkBrush" Color="#4CC2FF" />
          <SolidColorBrush x:Key="InspectorErrorTextBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="SessionGridSelectionBrush" Color="#2B5A8A" />
          <SolidColorBrush x:Key="SessionGridSelectionForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SessionGridHoverBrush" Color="#2A2D2E" />
          <!-- Accent Start-proxy label must stay dark on light cyan Accent (#4CC2FF). -->
          <SolidColorBrush x:Key="AccentButtonForeground" Color="#000000" />
          <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#000000" />
          <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <conv:StatusCodeBrushConverter x:Key="StatusCodeBrushConverter" />
      <conv:StatusCodeFontWeightConverter x:Key="StatusCodeFontWeightConverter" />
      <conv:StatusSeverityBrushConverter x:Key="StatusSeverityBrushConverter" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#006CBD" />
        <ColorPaletteResources x:Key="Dark"
                               Accent="#4CC2FF"
                               RegionColor="#1E1E1E"
                               BaseHigh="#E6E6E6"
                               BaseLow="#2D2D2D"
                               ListLow="#252526"
                               ChromeBlackHigh="#E6E6E6" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    <Style Selector="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource SessionGridSelectionBrush}" />
    </Style>
    <Style Selector="DataGridRow:selected">
      <Setter Property="Foreground" Value="{DynamicResource SessionGridSelectionForegroundBrush}" />
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource SessionGridHoverBrush}" />
    </Style>
    <!-- Hide current-cell / focus ring; sessions grid uses row selection only. -->
    <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="DataGrid:focus DataGridCell:current /template/ Grid#FocusVisual">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </Application.Styles>
</Application>
