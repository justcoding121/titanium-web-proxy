<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Titanium.Inspector.Localization"
        x:Class="Titanium.Inspector.Views.LoggingSettingsWindow"
        AutomationProperties.AutomationId="LoggingSettingsWindow"
        Title="{loc:Loc window.logging}"
        Width="560"
        MinWidth="440"
        MinHeight="220"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="SaveButton" Content="{loc:Loc common.save}" MinWidth="88" AutomationProperties.AutomationId="LoggingSave" />
      <Button x:Name="CancelButton" Content="{loc:Loc common.cancel}" MinWidth="88" IsCancel="True" AutomationProperties.AutomationId="LoggingCancel" />
    </StackPanel>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource InspectorErrorTextBrush}" AutomationProperties.AutomationId="LoggingStatus" />
    <ScrollViewer Classes="dialogBody">
    <StackPanel Spacing="12">
      <TextBlock TextWrapping="Wrap" Opacity="0.85" Text="{loc:Loc logging.help}" />
      <!-- Logging stays on so Recent logs always works. Only file output is optional. -->
      <CheckBox x:Name="WriteFileCheck" Content="{loc:Loc logging.writeFile}"
                AutomationProperties.AutomationId="LoggingWriteFile" />
      <StackPanel Spacing="4">
        <TextBlock FontWeight="SemiBold" Text="{loc:Loc logging.detail}" />
        <ComboBox x:Name="LevelCombo" HorizontalAlignment="Left" MinWidth="200"
                  AutomationProperties.AutomationId="LoggingLevel" />
        <TextBlock x:Name="LevelCost" Opacity="0.85" TextWrapping="Wrap" IsVisible="False"
                   Text="{loc:Loc logging.levelCost}"
                   AutomationProperties.AutomationId="LoggingLevelCost" />
      </StackPanel>
      <StackPanel x:Name="FileRows" Spacing="8">
        <StackPanel Spacing="4">
          <TextBlock FontWeight="SemiBold" Text="{loc:Loc logging.path}" />
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
              <Button x:Name="OpenFolderButton" Content="{loc:Loc runLog.openLogsFolder}" MinWidth="88"
                      AutomationProperties.AutomationId="LoggingOpenFolder" />
              <Button x:Name="BrowseButton" Content="{loc:Loc common.browse}" MinWidth="88"
                      AutomationProperties.AutomationId="LoggingBrowse" />
            </StackPanel>
            <TextBox x:Name="PathBox" AutomationProperties.AutomationId="LoggingPath" />
          </DockPanel>
        </StackPanel>
        <TextBlock x:Name="ThisRunFileText" Opacity="0.85" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="LoggingThisRunFile" />
      </StackPanel>
      <Expander x:Name="MoreOptions" Header="{loc:Loc logging.moreOptions}" IsExpanded="False"
                AutomationProperties.AutomationId="LoggingMoreOptions">
        <StackPanel Spacing="12" Margin="0,8,0,0">
          <StackPanel x:Name="FileSizeRow" Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{loc:Loc logging.fileSize}"
                         TextWrapping="Wrap" Margin="0,0,12,0" />
              <TextBox x:Name="FileSizeBox" Grid.Column="1" Width="72"
                       TextAlignment="Center" MaxLength="4"
                       AutomationProperties.Name="{loc:Loc logging.fileSize}"
                       AutomationProperties.AutomationId="LoggingFileSize" />
            </Grid>
            <TextBlock Opacity="0.75" TextWrapping="Wrap" Text="{loc:Loc logging.fileSizeHelp}" />
          </StackPanel>
          <StackPanel x:Name="KeepFilesRow" Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{loc:Loc logging.rolledFiles}"
                         TextWrapping="Wrap" Margin="0,0,12,0" />
              <TextBox x:Name="RolledFilesBox" Grid.Column="1" Width="72"
                       TextAlignment="Center" MaxLength="3"
                       AutomationProperties.Name="{loc:Loc logging.rolledFiles}"
                       AutomationProperties.AutomationId="LoggingRolledFiles" />
            </Grid>
            <TextBlock x:Name="KeepFilesHelp" Opacity="0.75" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{loc:Loc logging.memory}"
                         TextWrapping="Wrap" Margin="0,0,12,0" />
              <TextBox x:Name="MemoryLinesBox" Grid.Column="1" Width="72"
                       TextAlignment="Center" MaxLength="5"
                       AutomationProperties.Name="{loc:Loc logging.memory}"
                       AutomationProperties.AutomationId="LoggingMemoryLines" />
            </Grid>
            <TextBlock Opacity="0.75" TextWrapping="Wrap" Text="{loc:Loc logging.memoryHelp}" />
          </StackPanel>
        </StackPanel>
      </Expander>
    </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
