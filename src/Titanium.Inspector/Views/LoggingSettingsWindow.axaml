<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Titanium.Inspector.Localization"
        x:Class="Titanium.Inspector.Views.LoggingSettingsWindow"
        AutomationProperties.AutomationId="LoggingSettingsWindow"
        Title="{loc:Loc window.logging}"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.85"
               Text="{loc:Loc logging.help}" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="SaveButton" Content="{loc:Loc common.save}" MinWidth="88" AutomationProperties.AutomationId="LoggingSave" />
      <Button x:Name="CancelButton" Content="{loc:Loc common.cancel}" MinWidth="88" IsCancel="True" AutomationProperties.AutomationId="LoggingCancel" />
    </StackPanel>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource InspectorErrorTextBrush}" AutomationProperties.AutomationId="LoggingStatus" />
    <StackPanel Spacing="12">
      <CheckBox x:Name="EnableLoggingCheck" Content="{loc:Loc logging.enable}"
                AutomationProperties.AutomationId="LoggingEnabled" />
      <CheckBox x:Name="WriteFileCheck" Content="{loc:Loc logging.writeFile}"
                AutomationProperties.AutomationId="LoggingWriteFile" />
      <StackPanel Spacing="4">
        <TextBlock FontWeight="SemiBold" Text="{loc:Loc logging.detail}" />
        <TextBlock Opacity="0.75" TextWrapping="Wrap"
                   Text="{loc:Loc logging.detailHelp}" />
        <ComboBox x:Name="LevelCombo" HorizontalAlignment="Left" MinWidth="160"
                  AutomationProperties.AutomationId="LoggingLevel" />
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock FontWeight="SemiBold" Text="{loc:Loc logging.path}" />
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
            <Button x:Name="OpenFolderButton" Content="{loc:Loc common.openFolder}" MinWidth="88"
                    AutomationProperties.AutomationId="LoggingOpenFolder" />
            <Button x:Name="BrowseButton" Content="{loc:Loc common.browse}" MinWidth="88"
                    AutomationProperties.AutomationId="LoggingBrowse" />
          </StackPanel>
          <TextBox x:Name="PathBox" AutomationProperties.AutomationId="LoggingPath" />
        </DockPanel>
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
