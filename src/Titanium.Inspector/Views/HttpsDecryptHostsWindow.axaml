<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Titanium.Inspector.Views.HttpsDecryptHostsWindow"
        AutomationProperties.AutomationId="HttpsDecryptHostsWindow"
        Title="HTTPS decrypt hosts"
        Width="560" Height="480"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.85"
               Text="Decrypt HTTPS must still be enabled on the toolbar. Built-in SSO/pinning hosts (Microsoft login, Dropbox, Webex) always skip decryption. One host or *.example.com per line." />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="SaveButton" Content="Save" MinWidth="88" AutomationProperties.AutomationId="HttpsHostsSave" />
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" AutomationProperties.AutomationId="HttpsHostsCancel" />
    </StackPanel>
    <Grid RowDefinitions="Auto,*,Auto,*">
      <TextBlock Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,4" Text="Skip decryption (exclude)" />
      <TextBox x:Name="SkipHostsBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,8"
               Watermark="*.corp.example.com&#x0a;auth.example.com"
               AutomationProperties.AutomationId="HttpsSkipHosts" />
      <TextBlock Grid.Row="2" FontWeight="SemiBold" Margin="0,0,0,4"
                 Text="Only decrypt these hosts (optional — empty = decrypt all except skip/built-in)" />
      <TextBox x:Name="OnlyHostsBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap"
               Watermark="api.example.com&#x0a;*.myapp.dev"
               AutomationProperties.AutomationId="HttpsOnlyHosts" />
    </Grid>
  </DockPanel>
</Window>
