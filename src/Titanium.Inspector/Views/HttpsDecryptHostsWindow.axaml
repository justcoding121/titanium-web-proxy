<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Titanium.Inspector.Views.HttpsDecryptHostsWindow"
        AutomationProperties.AutomationId="HttpsDecryptHostsWindow"
        Title="HTTPS sites to decrypt"
        Width="560" Height="500"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.85"
               Text="Turn on Decrypt HTTPS on the toolbar first. Some login sites (Microsoft, Dropbox, Webex) never decrypt. One host or *.example.com per line." />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="SaveButton" Content="Save" MinWidth="88" AutomationProperties.AutomationId="HttpsHostsSave" />
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" AutomationProperties.AutomationId="HttpsHostsCancel" />
    </StackPanel>
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,*">
      <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Never decrypt these hosts" />
      <TextBlock Grid.Row="1" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,4"
                 Text="Stay encrypted even when Decrypt HTTPS is on." />
      <TextBox x:Name="SkipHostsBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,12"
               Watermark="*.corp.example.com&#x0a;auth.example.com"
               AutomationProperties.AutomationId="HttpsSkipHosts" />
      <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Only decrypt these hosts" />
      <TextBlock Grid.Row="4" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,4"
                 Text="Leave empty to decrypt everything except the list above and built-in login sites. If you add hosts here, only they are decrypted." />
      <TextBox x:Name="OnlyHostsBox" Grid.Row="5" AcceptsReturn="True" TextWrapping="Wrap"
               Watermark="api.example.com&#x0a;*.myapp.dev"
               AutomationProperties.AutomationId="HttpsOnlyHosts" />
    </Grid>
  </DockPanel>
</Window>
