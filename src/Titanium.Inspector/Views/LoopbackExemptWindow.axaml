<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:Titanium.Inspector.Services"
        x:Class="Titanium.Inspector.Views.LoopbackExemptWindow"
        Title="Loopback for sandboxed apps"
        Width="560" Height="480"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="Allow selected AppContainer / Store apps to reach the local proxy (Windows loopback exemption)." />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="ExemptButton" Content="Exempt selected" MinWidth="120" />
      <Button x:Name="ClearButton" Content="Clear exemptions" MinWidth="120" />
      <Button x:Name="CloseButton" Content="Close" MinWidth="80" IsCancel="True" />
    </StackPanel>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8" />
    <ListBox x:Name="PackageList" SelectionMode="Multiple">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="svc:AppContainerInfo">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <CheckBox IsChecked="{Binding IsExempt}" IsEnabled="False" />
            <TextBlock Text="{Binding DisplayName}" />
            <TextBlock Text="{Binding PackageFamilyName}" Opacity="0.6" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
