<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:Titanium.Inspector.Services"
        x:Class="Titanium.Inspector.Views.LoopbackExemptWindow" AutomationProperties.AutomationId="LoopbackExemptWindow"
        Title="Allow Store apps to use this proxy"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="Windows Store / UWP apps are blocked from localhost by default. Check apps that should use Inspector, then Apply. Clear all removes every allow entry." />
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
        <Button x:Name="CheckAllButton"
                Content="Check all"
                MinWidth="88"
                AutomationProperties.AutomationId="LoopbackCheckAll" />
        <Button x:Name="UncheckAllButton"
                Content="Uncheck all"
                MinWidth="88"
                AutomationProperties.AutomationId="LoopbackUncheckAll" />
      </StackPanel>
      <TextBox x:Name="FilterBox"
               Watermark="Filter by app name…"
               AutomationProperties.AutomationId="LoopbackFilter" />
    </DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="ExemptButton" AutomationProperties.AutomationId="LoopbackExempt" Content="Apply" MinWidth="120" />
      <Button x:Name="ClearButton" AutomationProperties.AutomationId="LoopbackClear" Content="Clear all" MinWidth="120" />
      <Button x:Name="CloseButton" AutomationProperties.AutomationId="LoopbackClose" Content="Close" MinWidth="88" IsCancel="True" />
    </StackPanel>
    <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="LoopbackStatus" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8" />
    <DataGrid x:Name="PackageGrid"
              AutomationProperties.AutomationId="LoopbackPackages"
              SelectionMode="Single"
              IsReadOnly="False"
              CanUserResizeColumns="True"
              CanUserReorderColumns="False"
              CanUserSortColumns="True"
              GridLinesVisibility="Horizontal"
              AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Allow" Width="70" SortMemberPath="IsExempt" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="svc:AppContainerInfo">
              <CheckBox IsChecked="{Binding IsExempt, Mode=TwoWay}"
                        IsCheckedChanged="OnExemptCheckChanged"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="App name" Binding="{Binding DisplayName}" Width="*" MinWidth="120" IsReadOnly="True" />
        <DataGridTemplateColumn Header="Package ID" Width="2*" MinWidth="140" SortMemberPath="PackageFamilyName" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="svc:AppContainerInfo">
              <TextBlock Text="{Binding PackageFamilyName}"
                         TextTrimming="CharacterEllipsis"
                         Opacity="0.75"
                         VerticalAlignment="Center"
                         ToolTip.Tip="{Binding PackageFamilyName}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
