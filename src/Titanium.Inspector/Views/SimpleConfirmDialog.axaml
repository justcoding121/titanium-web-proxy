<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Titanium.Inspector.Views.SimpleConfirmDialog"
        Title="Confirm"
        Width="440" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="AcceptButton" MinWidth="88" IsDefault="True" />
      <Button x:Name="CancelButton" MinWidth="88" IsCancel="True" />
    </StackPanel>
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" />
  </DockPanel>
</Window>
