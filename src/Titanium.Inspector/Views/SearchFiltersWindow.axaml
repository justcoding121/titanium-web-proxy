<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Titanium.Inspector.Localization"
        x:Class="Titanium.Inspector.Views.SearchFiltersWindow"
        AutomationProperties.AutomationId="SearchFiltersWindow"
        Title="{loc:Loc window.filters}"
        Width="560" Height="480"
        MinWidth="420" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="CancelButton" Content="{loc:Loc common.cancel}" MinWidth="88" IsCancel="True"
              AutomationProperties.AutomationId="SearchFiltersCancel" />
      <Button x:Name="ApplyButton" Content="{loc:Loc common.apply}" MinWidth="88" IsDefault="True"
              AutomationProperties.AutomationId="SearchFiltersApply" />
    </StackPanel>
    <ScrollViewer Classes="dialogBody">
      <StackPanel Spacing="14">
        <StackPanel Spacing="4">
          <TextBlock FontWeight="SemiBold" Text="{loc:Loc filters.search}" />
          <TextBlock Opacity="0.75" TextWrapping="Wrap"
                     Text="{loc:Loc filters.searchHelp}" />
          <TextBox x:Name="RemainderBox" Classes="searchQuery" Watermark="{loc:Loc filters.searchWatermark}"
                   AutomationProperties.AutomationId="SearchFiltersRemainder" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock FontWeight="SemiBold" Text="{loc:Loc filters.hideHeading}" />
          <TextBlock Opacity="0.75" TextWrapping="Wrap"
                     Text="{loc:Loc filters.hideHelp}" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="{loc:Loc filters.hosts}" />
          <ItemsControl x:Name="HostList" AutomationProperties.AutomationId="SearchFiltersHostList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                  <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                  <Button Content="{loc:Loc common.remove}" Padding="8,2" MinWidth="0"
                          Click="OnRemoveHost"
                          AutomationProperties.AutomationId="SearchFiltersRemoveHost" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="HostAddBox" Grid.Column="0" Margin="0,0,8,0" Watermark="{loc:Loc filters.addHostWatermark}"
                     AutomationProperties.AutomationId="SearchFiltersHostAdd" />
            <Button x:Name="HostAddButton" Grid.Column="1" Content="{loc:Loc filters.addHost}" MinWidth="88"
                    AutomationProperties.AutomationId="SearchFiltersAddHost" />
          </Grid>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="{loc:Loc filters.processes}" />
          <ItemsControl x:Name="ProcessList" AutomationProperties.AutomationId="SearchFiltersProcessList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                  <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                  <Button Content="{loc:Loc common.remove}" Padding="8,2" MinWidth="0"
                          Click="OnRemoveProcess"
                          AutomationProperties.AutomationId="SearchFiltersRemoveProcess" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="ProcessAddBox" Grid.Column="0" Margin="0,0,8,0" Watermark="{loc:Loc filters.addProcessWatermark}"
                     AutomationProperties.AutomationId="SearchFiltersProcessAdd" />
            <Button x:Name="ProcessAddButton" Grid.Column="1" Content="{loc:Loc filters.addProcess}" MinWidth="88"
                    AutomationProperties.AutomationId="SearchFiltersAddProcess" />
          </Grid>
          <TextBlock Opacity="0.75" TextWrapping="Wrap"
                     Text="{loc:Loc filters.processSpace}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
