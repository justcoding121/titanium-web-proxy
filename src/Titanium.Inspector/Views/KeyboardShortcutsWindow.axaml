<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Titanium.Inspector.Localization"
        x:Class="Titanium.Inspector.Views.KeyboardShortcutsWindow"
        Title="{loc:Loc menu.keyboardShortcuts}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        AutomationProperties.AutomationId="KeyboardShortcutsWindow">
  <DockPanel Margin="16">
    <Button DockPanel.Dock="Bottom" Content="{loc:Loc common.close}"
            HorizontalAlignment="Right" MinWidth="88" Margin="0,16,0,0" IsCancel="True"
            AutomationProperties.AutomationId="KeyboardShortcutsClose" />
    <StackPanel x:Name="RowsHost" />
  </DockPanel>
</Window>
