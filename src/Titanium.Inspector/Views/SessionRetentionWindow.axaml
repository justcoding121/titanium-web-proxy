<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Titanium.Inspector.Views.SessionRetentionWindow"
        AutomationProperties.AutomationId="SessionRetentionWindow"
        Title="Session retention"
        Width="480" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.85"
               Text="Limits how long-running capture keeps sessions in memory and on disk. Changes take effect the next time Inspector starts." />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="SaveButton" Content="Save" MinWidth="88" AutomationProperties.AutomationId="RetentionSave" />
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" AutomationProperties.AutomationId="RetentionCancel" />
    </StackPanel>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
               Foreground="#C0392B" AutomationProperties.AutomationId="RetentionStatus" />
    <StackPanel Spacing="10">
      <CheckBox x:Name="SpillBodiesCheck" Content="Spill bodies to disk"
                AutomationProperties.AutomationId="RetentionSpillBodies" />
      <Grid ColumnDefinitions="*,120">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="0,0,12,8" VerticalAlignment="Center" Text="Disk cache max size (MB)" />
        <TextBox x:Name="DiskCacheMaxMbBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                 AutomationProperties.AutomationId="RetentionDiskCacheMb" />
        <TextBlock Grid.Row="1" Margin="0,0,12,8" VerticalAlignment="Center" Text="Disk cache max age (days)" />
        <TextBox x:Name="DiskCacheMaxAgeDaysBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                 AutomationProperties.AutomationId="RetentionDiskCacheAgeDays" />
        <TextBlock Grid.Row="2" Margin="0,0,12,8" VerticalAlignment="Center" Text="Max sessions in memory" />
        <TextBox x:Name="MaxSessionsBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                 AutomationProperties.AutomationId="RetentionMaxSessions" />
        <TextBlock Grid.Row="3" Margin="0,0,12,8" VerticalAlignment="Center" Text="Hot body sessions" />
        <TextBox x:Name="HotBodySessionsBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                 AutomationProperties.AutomationId="RetentionHotBodies" />
        <TextBlock Grid.Row="4" Margin="0,0,12,0" VerticalAlignment="Center" Text="Max body RAM (MB)" />
        <TextBox x:Name="MaxBodyRamMbBox" Grid.Row="4" Grid.Column="1"
                 AutomationProperties.AutomationId="RetentionMaxBodyRamMb" />
      </Grid>
    </StackPanel>
  </DockPanel>
</Window>
