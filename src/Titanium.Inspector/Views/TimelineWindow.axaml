<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Titanium.Inspector.Localization"
        xmlns:views="using:Titanium.Inspector.Views"
        x:Class="Titanium.Inspector.Views.TimelineWindow"
        AutomationProperties.AutomationId="TimelineWindow"
        Title="{loc:Loc menu.timeline}"
        Width="960"
        Height="640"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <WrapPanel x:Name="Legend" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"
               AutomationProperties.AutomationId="TimelineLegend" />
    <TextBlock x:Name="Summary" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
               AutomationProperties.AutomationId="TimelineSummary" />
    <TextBlock x:Name="Detail" DockPanel.Dock="Bottom" Margin="0,4,0,0" TextWrapping="Wrap"
               AutomationProperties.AutomationId="TimelineDetail" />
    <ScrollViewer x:Name="ChartScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <views:TimelineChart x:Name="Chart" AutomationProperties.AutomationId="TimelineChart" />
    </ScrollViewer>
  </DockPanel>
</Window>
