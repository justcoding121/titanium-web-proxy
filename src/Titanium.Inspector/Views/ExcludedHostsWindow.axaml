<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Titanium.Inspector.Views.ExcludedHostsWindow"
        AutomationProperties.AutomationId="ExcludedHostsWindow"
        Title="Excluded hosts"
        Width="640" Height="600"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock x:Name="IntroText" TextWrapping="Wrap" Opacity="0.9" />
      <TextBlock x:Name="ScopeBanner" TextWrapping="Wrap" Opacity="0.75" />
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <Button x:Name="ResetDefaultsButton" DockPanel.Dock="Left" Content="Reset to defaults" MinWidth="120"
              AutomationProperties.AutomationId="ExcludedHostsResetDefaults" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="SaveButton" Content="Save" MinWidth="88" AutomationProperties.AutomationId="ExcludedHostsSave" />
        <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" AutomationProperties.AutomationId="ExcludedHostsCancel" />
      </StackPanel>
    </DockPanel>
    <ScrollViewer>
      <StackPanel Spacing="12">
        <TextBlock FontWeight="SemiBold" Text="Bypass proxy (OS)" />
        <TextBlock Opacity="0.75" TextWrapping="Wrap"
                   Text="Traffic never reaches Inspector when System proxy is on. Seeded with Microsoft identity / SSO / RDP hosts. Removing them can break sign-in while System proxy is enabled." />
        <TextBox x:Name="BypassHostsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                 Watermark="*.microsoftonline.com&#x0a;login.live.com"
                 FontFamily="Consolas,Courier New,monospace"
                 AutomationProperties.AutomationId="ExcludedBypassHosts" />

        <TextBlock FontWeight="SemiBold" Text="Tunnel only (no decrypt)" />
        <TextBlock Opacity="0.75" TextWrapping="Wrap"
                   Text="CONNECT stays visible; TLS stays opaque when Decrypt HTTPS is on. Seeded with certificate-pinning hosts (Dropbox, Webex)." />
        <TextBox x:Name="SkipHostsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                 Watermark="dropbox.com&#x0a;webex.com"
                 FontFamily="Consolas,Courier New,monospace"
                 AutomationProperties.AutomationId="ExcludedSkipHosts" />

        <TextBlock FontWeight="SemiBold" Text="Auto-tunnel on decrypt failure" />
        <CheckBox x:Name="LearningEnabledCheck" Content="Learn hosts that fail origin TLS under decrypt (session only)"
                  AutomationProperties.AutomationId="ExcludedLearningEnabled" />
        <TextBlock Opacity="0.75" TextWrapping="Wrap"
                   Text="When origin TLS fails repeatedly under decrypt, or MITM HTTPS returns 403/429 repeatedly (bot/WAF), Inspector stops decrypting that host for later connections in this session. The current MITM connection is not converted. Prefetch is skipped once a host is learned. List is capped and forgotten on restart unless you promote. Certificate-pinning apps still belong on Tunnel only." />
        <TextBlock x:Name="LearningPausedBanner" IsVisible="False" Opacity="0.85" TextWrapping="Wrap"
                   Text="Learning paused — existing entries kept until forgotten." />
        <ListBox x:Name="LearnedList" MinHeight="96" MaxHeight="180"
                 AutomationProperties.AutomationId="ExcludedLearnedList" />
        <TextBlock x:Name="LearnedEmptyText" Opacity="0.6" Text="No hosts learned yet." />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="PromoteLearnedButton" Content="Promote to tunnel-only" MinWidth="140"
                  AutomationProperties.AutomationId="ExcludedLearnedPromote" />
          <Button x:Name="ForgetLearnedButton" Content="Forget" MinWidth="88"
                  AutomationProperties.AutomationId="ExcludedLearnedForget" />
          <Button x:Name="ClearLearnedButton" Content="Clear all learned" MinWidth="120"
                  AutomationProperties.AutomationId="ExcludedLearnedClear" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
