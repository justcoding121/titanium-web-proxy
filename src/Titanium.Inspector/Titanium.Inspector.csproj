<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Titanium.Inspector</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SignAssembly>false</SignAssembly>
    <VersionPrefix>7.0.7</VersionPrefix>
    <Authors>Jehonathan Thomas</Authors>
    <Description>Titanium Inspector desktop traffic debugger (PolyForm Noncommercial).</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <ApplicationId>com.justcoding121.titaniuminspector</ApplicationId>
    <AssemblyName>TitaniumInspector</AssemblyName>
    <IsPackable>false</IsPackable>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Bundle id: com.justcoding121.titaniuminspector -->
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Titanium.Inspector.Tests, " />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.8" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.8" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.8" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.8" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.8" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Titanium.Web.Proxy.Abstractions\Titanium.Web.Proxy.Abstractions.csproj" />
    <ProjectReference Include="..\Titanium.Web.Proxy\Titanium.Web.Proxy.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
  <!-- Local macOS Debug/dotnet run: copy Homebrew MsQuic beside the apphost (Release zips use bundle-http3-native.ps1). -->
  <Target Name="CopyMacHttp3Natives" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)..\..\tools\packaging\copy-http3-natives-osx.sh&quot; &quot;$(TargetDir)&quot;"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low" />
    <!-- Avoid a re-exec when launching via `dotnet run` / IDE: Quic only dlopen()s by leaf name. -->
    <PropertyGroup>
      <_Http3LaunchSettings>$(MSBuildProjectDirectory)\Properties\launchSettings.json</_Http3LaunchSettings>
      <_Http3TargetDir>$([System.IO.Path]::GetFullPath('$(TargetDir)').TrimEnd('\').TrimEnd('/'))</_Http3TargetDir>
    </PropertyGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\Properties" />
    <WriteLinesToFile File="$(_Http3LaunchSettings)" Overwrite="true" Encoding="UTF-8"
      Lines='{"profiles":{"TitaniumInspector":{"commandName":"Project","environmentVariables":{"DYLD_FALLBACK_LIBRARY_PATH":"$(_Http3TargetDir)"}}}}' />
  </Target>
</Project>
