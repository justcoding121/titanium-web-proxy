<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Titanium.Plus</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>StrongNameKey.snk</AssemblyOriginatorKeyFile>
    <VersionPrefix>8.0.0</VersionPrefix>
    <Authors>Jehonathan Thomas</Authors>
    <Description>Titanium Web Proxy Plus advanced features plugin (PolyForm Noncommercial).</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Not published to nuget.org -->
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Titanium.Web.Proxy.Abstractions\Titanium.Web.Proxy.Abstractions.csproj" />
    <ProjectReference Include="..\Titanium.Web.Proxy\Titanium.Web.Proxy.csproj" />
    <!-- Path-loaded beside the CLI. ReferenceOutputAssembly stays false so Plus does not compile against them. -->
    <ProjectReference Include="..\Titanium.Xds\Titanium.Xds.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Titanium.Cli.GeoIp\Titanium.Cli.GeoIp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Titanium.Plus.Tests, " />
    <InternalsVisibleTo Include="Titanium.Web.Proxy.IntegrationTests, " />
  </ItemGroup>
  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Security\Waf\waf-pack-1.json" LogicalName="Titanium.Plus.Security.Waf.waf-pack-1.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="DnsClient" Version="$(DnsClientVersion)" />
    <PackageReference Include="Google.Api.CommonProtos" Version="2.17.0" />
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.6.1" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.31" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.6.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
  <!-- E2E and RPS copy *.dll from this output. The satellites are not compile references. -->
  <Target Name="CopyPlusSatellites" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Titanium.Xds\Titanium.Xds.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Titanium.Cli.GeoIp\Titanium.Cli.GeoIp.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" />
    <ItemGroup>
      <_XdsSatellite Include="$(MSBuildThisFileDirectory)..\Titanium.Xds\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <_GeoIpSatellite Include="$(MSBuildThisFileDirectory)..\Titanium.Cli.GeoIp\bin\$(Configuration)\$(TargetFramework)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_XdsSatellite)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_GeoIpSatellite)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
