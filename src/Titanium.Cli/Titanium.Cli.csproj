<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Titanium.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <SignAssembly>false</SignAssembly>
    <VersionPrefix>7.0.27</VersionPrefix>
    <Authors>Jehonathan Thomas</Authors>
    <Description>Titanium Web Proxy CLI (titanium / twp).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AssemblyName>titanium</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- CLI enables experimental HTTP/3 via listener config; suppress TWP001 like Core. -->
    <NoWarn>$(NoWarn);TWP001</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Titanium.Cli.Tests" />
    <InternalsVisibleTo Include="Titanium.E2E.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Titanium.Web.Proxy\Titanium.Web.Proxy.csproj" />
    <ProjectReference Include="..\Titanium.Web.Proxy.Abstractions\Titanium.Web.Proxy.Abstractions.csproj" />
    <ProjectReference Include="..\Titanium.Web.Proxy.Configuration\Titanium.Web.Proxy.Configuration.csproj" />
    <ProjectReference Include="..\Titanium.Web.Proxy.Scripting\Titanium.Web.Proxy.Scripting.csproj" />
    <ProjectReference Include="..\Titanium.Cli.GeoIp\Titanium.Cli.GeoIp.csproj" ReferenceOutputAssembly="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Certes" Version="3.0.4" />
    <PackageReference Include="ZstdSharp.Port" Version="$(ZstdSharpPortVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="OpenTelemetry" Version="$(OpenTelemetryVersion)" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>
  <!-- Local macOS Debug/dotnet run: copy Homebrew MsQuic beside the apphost (Release zips use bundle-http3-native.ps1). -->
  <Target Name="CopyGeoIpSatellite" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Titanium.Cli.GeoIp\Titanium.Cli.GeoIp.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" />
    <ItemGroup>
      <_GeoIpSatellite Include="$(MSBuildThisFileDirectory)..\Titanium.Cli.GeoIp\bin\$(Configuration)\$(TargetFramework)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_GeoIpSatellite)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyMacHttp3Natives" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)..\..\tools\packaging\copy-http3-natives-osx.sh&quot; &quot;$(TargetDir)&quot;" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" />
    <PropertyGroup>
      <_Http3LaunchSettings>$(MSBuildProjectDirectory)\Properties\launchSettings.json</_Http3LaunchSettings>
      <_Http3TargetDir>$([System.IO.Path]::GetFullPath('$(TargetDir)').TrimEnd('\').TrimEnd('/'))</_Http3TargetDir>
    </PropertyGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\Properties" />
    <WriteLinesToFile File="$(_Http3LaunchSettings)" Overwrite="true" Encoding="UTF-8" Lines="{&quot;profiles&quot;:{&quot;titanium&quot;:{&quot;commandName&quot;:&quot;Project&quot;,&quot;environmentVariables&quot;:{&quot;DYLD_FALLBACK_LIBRARY_PATH&quot;:&quot;$(_Http3TargetDir)&quot;}}}}" />
  </Target>
</Project>
