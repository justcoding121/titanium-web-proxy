    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "algorithm": {
            "type": "string",
            "enum": [
              "fixedWindow",
              "tokenBucket"
            ]
          },
          "allow": {
            "type": "string"
          },
          "burst": {
            "type": "integer",
            "minimum": 1
          },
          "cacheMaxEntries": {
            "type": "integer"
          },
          "cacheSeconds": {
            "type": "integer"
          },
          "copyResponseHeaders": {
            "type": "array",
