          "headerName": {
            "type": "string"
          },
          "headerValue": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "pattern": "^(client|forwardedClient|route|header:[!#$%\u0026\u0027*\u002B.^_\u0060|~0-9A-Za-z-]\u002B|cookie:[!#$%\u0026\u0027*\u002B.^_\u0060|~0-9A-Za-z-]\u002B)$"
