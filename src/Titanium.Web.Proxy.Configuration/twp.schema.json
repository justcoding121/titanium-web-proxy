              "maxConcurrency": {
                "type": "integer"
              },
              "samplePercent": {
                "type": "integer"
              }
            }
          },
          "order": {
            "type": "integer"
          },
          "policies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "redirect": {
            "type": "object",
