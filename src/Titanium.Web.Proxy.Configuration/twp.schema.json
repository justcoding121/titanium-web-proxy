              },
              "host": {
                "type": "string"
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "method": {
                "type": "string"
              },
              "methods": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "path": {
                "type": "string"
              },
              "pathCaseSensitive": {
                "type": "boolean"
              },
              "pathKind": {
                "type": "string"
              },
              "query": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "mirror": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "clusterId": {
                "type": "string"
              },
              "maxBodyBytes": {
                "type": "integer",
