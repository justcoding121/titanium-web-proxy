          },
          "decryptSsl": {
            "type": "boolean"
          },
          "enableHttp2": {
            "type": "boolean"
          },
          "enableHttp3": {
            "type": "boolean"
          },
          "forwardHost": {
            "type": "string"
          },
          "forwardPort": {
            "type": "integer"
          },
          "genericCertificateName": {
            "type": "string"
          },
          "handshakeTimeoutSeconds": {
            "type": "integer"
          },
          "host": {
            "type": "string"
          },
          "idleTimeoutSeconds": {
            "type": "integer"
          },
          "masque": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "allowHttp11Upgrade": {
                "type": "boolean"
              },
              "allowedPorts": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "blockPrivateTargets": {
                "type": "boolean"
              },
              "credentials": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "username",
                    "passwordEnv"
                  ],
                  "properties": {
                    "passwordEnv": {
                      "type": "string"
                    },
                    "username": {
                      "type": "string"
                    }
                  }
                }
              },
              "idleTimeoutSeconds": {
                "type": "integer"
              },
              "maxBytesPerSecond": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1073741824
              },
              "maxDatagramsPerSecond": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "maxTunnels": {
                "type": "integer",
                "minimum": 1
              },
              "maxTunnelsPerClient": {
                "type": "integer",
                "minimum": 1
              },
              "requireAuth": {
                "type": "boolean"
              }
            }
          },
          "maxCachedConnections": {
            "type": "integer"
          },
          "maxConcurrentClients": {
            "type": "integer"
          },
          "maxInboundBidirectionalStreams": {
            "type": "integer"
          },
          "maxInboundUnidirectionalStreams": {
            "type": "integer"
          },
          "passthrough": {
            "type": "boolean"
          },
          "port": {
            "type": "integer"
          },
          "sendProxyProtocol": {
            "type": "string",
            "enum": [
              "none",
              "v2"
            ]
          },
          "sniDefaultClusterId": {
            "type": "string"
          },
          "sniReadTimeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "sniRoutes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "clusterId": {
                  "type": "string"
                },
                "serverName": {
                  "type": "string"
                }
              }
            }
          },
          "trustedProxyProtocolSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enableConsole": {
          "type": "boolean"
        },
        "enableConsoleColors": {
          "type": "boolean"
        },
        "enableFile": {
          "type": "boolean"
