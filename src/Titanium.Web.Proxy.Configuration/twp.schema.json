            "properties": {
              "host": {
                "type": "string"
              },
              "httpToHttps": {
                "type": "boolean"
              },
              "path": {
                "type": "string"
              },
              "port": {
                "type": "integer"
              },
              "preserveQuery": {
                "type": "boolean"
              },
              "scheme": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              }
            }
          },
          "retry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "attempts": {
                "type": "integer"
              },
              "backoffMilliseconds": {
                "type": "integer"
              },
              "budgetMinConcurrent": {
                "type": "integer"
              },
              "budgetPercent": {
                "type": "integer"
              },
              "honorRetryAfter": {
                "type": "boolean"
              },
