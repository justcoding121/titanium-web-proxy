{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titaniumproxy.com/twp.schema.json",
  "title": "Titanium Web Proxy configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "certificates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acmeDirectory": {
          "type": "string"
        },
        "acmeDomain": {
          "type": "string"
        },
        "acmeEmail": {
          "type": "string"
        },
        "certificatePath": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "password": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        },
        "privateKeyPath": {
          "type": "string"
        }
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "affinityCookie": {
            "type": "string"
          },
          "affinityHeader": {
            "type": "string"
          },
          "algorithm": {
            "type": "string"
          },
          "destinations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "address": {
                  "type": "string"
                },
                "affinityKey": {
                  "type": "string"
                },
                "backup": {
                  "type": "boolean"
                },
                "dnsRefreshSeconds": {
                  "type": "integer"
                },
                "health": {
                  "type": "string"
                },
                "host": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "maxConcurrentRequests": {
                  "type": "integer"
                },
                "port": {
                  "type": "integer"
                },
                "priority": {
                  "type": "integer"
                },
                "slowStartSeconds": {
                  "type": "integer"
                },
                "useDestinationHost": {
                  "type": "boolean"
                },
                "useHttps": {
                  "type": "boolean"
                },
                "weight": {
                  "type": "integer"
                }
              }
            }
          },
          "hashKey": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          },
          "healthCheck": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "active": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "expectedStatus": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "healthyThreshold": {
                    "type": "integer"
                  },
                  "intervalSeconds": {
                    "type": "integer"
                  },
                  "jitterPercent": {
                    "type": "integer"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "query": {
                    "type": "string"
                  },
                  "timeoutSeconds": {
                    "type": "integer"
                  },
                  "unhealthyThreshold": {
                    "type": "integer"
                  }
                }
              },
              "availabilityPolicy": {
                "type": "string"
              },
              "panicThresholdPercent": {
                "type": "integer"
              },
              "passive": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "consecutiveFailures": {
                    "type": "integer"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "failureRate": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "minimumRequests": {
                        "type": "integer"
                      },
                      "threshold": {
                        "type": "number"
                      },
                      "windowSeconds": {
                        "type": "integer"
                      }
                    }
                  },
                  "failureStatusCodes": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "halfOpenSuccesses": {
                    "type": "integer"
                  },
                  "maxBackoffSeconds": {
                    "type": "integer"
                  },
                  "maxEjectionPercent": {
                    "type": "integer"
                  },
                  "reactivateAfterSeconds": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "httpClient": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "acceptAnyServerCertificate": {
                "type": "boolean"
              },
              "caBundlePath": {
                "type": "string"
              },
              "clientCertificateKeyPath": {
                "type": "string"
              },
              "clientCertificatePasswordEnv": {
                "type": "string"
              },
              "clientCertificatePath": {
                "type": "string"
              },
              "connectTimeout": {
                "type": "string"
              },
              "connectionKey": {
                "type": "string"
              },
              "maxConnectionsPerServer": {
                "type": "integer",
                "description": "Hard cap on open upstream connections per destination, including idle pooled sockets. Waiters time out after the connect timeout with 503 and Retry-After."
              },
              "requestTimeout": {
                "type": "string"
              },
              "serverName": {
                "type": "string"
              },
              "sslProtocols": {
                "type": "string"
              },
              "verifyHostname": {
                "type": "boolean"
              }
            }
          },
          "id": {
            "type": "string"
          },
          "loadBalancingPolicy": {
            "type": "string"
          },
          "queue": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxLength": {
                "type": "integer"
              },
              "timeoutMilliseconds": {
                "type": "integer"
              }
            }
          },
          "retry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "attempts": {
                "type": "integer"
              },
              "backoffMilliseconds": {
                "type": "integer"
              },
              "budgetMinConcurrent": {
                "type": "integer"
              },
              "budgetPercent": {
                "type": "integer"
              },
              "honorRetryAfter": {
                "type": "boolean"
              },
              "jitterPercent": {
                "type": "integer"
              },
              "maxBackoffMilliseconds": {
                "type": "integer"
              },
              "maxBufferedBodyBytes": {
                "type": "integer"
              },
              "perTryTimeoutMilliseconds": {
                "type": "integer"
              },
              "retryNonIdempotent": {
                "type": "boolean"
              },
              "statusCodes": {
                "type": "array",
