          "maxRequestBodyBytes": {
            "type": "integer"
          },
          "method": {
            "type": "string"
          },
          "methods": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "origins": {
            "type": "string"
          },
          "sendHeaders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeoutMilliseconds": {
            "type": "integer"
          },
          "timeoutSeconds": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          },
          "windowSeconds": {
            "type": "integer"
          }
        }
      }
    },
    "routes": {
      "type": "array",
