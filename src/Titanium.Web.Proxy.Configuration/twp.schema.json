            "port": {
              "type": "integer"
            },
            "sharedSecret": {
              "type": "string"
            },
            "sharedSecretEnv": {
              "type": "string"
            },
            "sharedSecretFile": {
              "type": "string"
            }
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
