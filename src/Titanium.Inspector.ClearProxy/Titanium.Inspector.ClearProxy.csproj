<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Titanium.Inspector.ClearProxy</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <SignAssembly>false</SignAssembly>
    <VersionPrefix>8.0.8</VersionPrefix>
    <Authors>Jehonathan Thomas</Authors>
    <Description>Clears leftover Titanium Inspector loopback proxy hooks when the app is not running.</Description>
    <AssemblyName>titanium-inspector-clear</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Login/timer helper: one binary under /usr/lib, not a full runtime folder. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Titanium.Web.Proxy\Titanium.Web.Proxy.csproj" />
  </ItemGroup>
</Project>
