<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.9.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.9.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Titanium.Web.Proxy.Configuration\Titanium.Web.Proxy.Configuration.csproj" />
    <ProjectReference Include="..\..\src\Titanium.Web.Proxy\Titanium.Web.Proxy.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Titanium.Web.Proxy.UnitTests\UpstreamTlsTestPki.cs" Link="Helpers\UpstreamTlsTestPki.cs" />
  </ItemGroup>
  <!-- Golden configs from older releases; Compat/README.md holds the schema bump rules. -->
  <ItemGroup>
    <None Include="Compat\*.yaml;Compat\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Compat\Snapshots\*.json" CopyToOutputDirectory="PreserveNewest" Link="Compat\Snapshots\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Titanium.Web.Proxy.TestPlugins\Titanium.Web.Proxy.TestPlugins.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\examples\Titanium.Web.Proxy.Examples.RoutePlugin\Titanium.Web.Proxy.Examples.RoutePlugin.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
