;; A proxy-wasm 0.2.1 HTTP filter that walks host imports the other samples never call and reports each result code.
;; On request headers it records one ASCII character per call ('0' + the WasmResult code) in the x-results header:
;;   0 get_log_level            1 get_current_time_nanoseconds   2 set_tick_period(0)        3 get_header_map_size
;;   4 get_header_map_pairs     5 replace_header_map_value x-a   6 get_header_map_value (missing key)
;;   7 get_header_map_value on an unknown map type               8 get_property (unknown path)
;;   9 set_property my.prop     10 get_property my.prop          11 get_buffer_status (request body, none yet)
;;   12 get_buffer_bytes (request body, none yet)                13 get_configuration        14 get_status
;;   15 set_effective_context (unknown id)                       16 set_effective_context (this context)
;;   17 clear_route_cache       18 done                          19 set_header_map_pairs (one pair x-set: v)
;;   20 set_header_map_pairs (truncated payload)                 21 get_header_map_pairs after the replacement
;;   22 grpc_cancel (unknown token)                              23 grpc_close (unknown token)
;;   24 grpc_send (unknown token)                                25 call_foreign_function (unknown name)
;;   26 define_metric, same name as a counter then as a gauge    27 get_metric (unknown id)
;;   28 dequeue_shared_queue (unknown token)                     29 enqueue_shared_queue (unknown token)
;;   30 resolve_shared_queue (unknown queue)                     31 get_shared_data (missing key)
;;   32 send_local_response with a malformed header payload
(module
  (import "env" "proxy_get_log_level" (func $get_log_level (param i32) (result i32)))
  (import "env" "proxy_get_current_time_nanoseconds" (func $get_time (param i32) (result i32)))
  (import "env" "proxy_set_tick_period_milliseconds" (func $tick_period (param i32) (result i32)))
  (import "env" "proxy_get_header_map_size" (func $map_size (param i32 i32) (result i32)))
  (import "env" "proxy_get_header_map_pairs" (func $map_pairs (param i32 i32 i32) (result i32)))
  (import "env" "proxy_set_header_map_pairs" (func $set_pairs (param i32 i32 i32) (result i32)))
  (import "env" "proxy_get_header_map_value" (func $get_header (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "proxy_replace_header_map_value" (func $replace_header (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "proxy_add_header_map_value" (func $add_header (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "proxy_get_property" (func $get_property (param i32 i32 i32 i32) (result i32)))
  (import "env" "proxy_set_property" (func $set_property (param i32 i32 i32 i32) (result i32)))
  (import "env" "proxy_get_buffer_status" (func $buffer_status (param i32 i32 i32) (result i32)))
  (import "env" "proxy_get_buffer_bytes" (func $buffer_bytes (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "proxy_get_configuration" (func $get_configuration (param i32 i32) (result i32)))
  (import "env" "proxy_get_status" (func $get_status (param i32 i32 i32) (result i32)))
  (import "env" "proxy_set_effective_context" (func $set_effective (param i32) (result i32)))
  (import "env" "proxy_clear_route_cache" (func $clear_route_cache (result i32)))
  (import "env" "proxy_done" (func $done (result i32)))
  (import "env" "proxy_grpc_cancel" (func $grpc_cancel (param i32) (result i32)))
  (import "env" "proxy_grpc_close" (func $grpc_close (param i32) (result i32)))
  (import "env" "proxy_grpc_send" (func $grpc_send (param i32 i32 i32 i32) (result i32)))
  (import "env" "proxy_call_foreign_function" (func $foreign (param i32 i32 i32 i32 i32 i32) (result i32)))
  (import "env" "proxy_define_metric" (func $define_metric (param i32 i32 i32 i32) (result i32)))
  (import "env" "proxy_get_metric" (func $get_metric (param i32 i32) (result i32)))
  (import "env" "proxy_dequeue_shared_queue" (func $dequeue (param i32 i32 i32) (result i32)))
  (import "env" "proxy_enqueue_shared_queue" (func $enqueue (param i32 i32 i32) (result i32)))
  (import "env" "proxy_resolve_shared_queue" (func $resolve_queue (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "proxy_get_shared_data" (func $get_shared (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "proxy_send_local_response" (func $send_local (param i32 i32 i32 i32 i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 2)
  (global $heap (mut i32) (i32.const 8192))
  (data (i32.const 16) "x-results")
  (data (i32.const 32) "x-a")
  (data (i32.const 40) "new")
  (data (i32.const 48) "x-missing")
  (data (i32.const 64) "my.prop")
  (data (i32.const 72) "zz")
  (data (i32.const 80) "no.such.prop")
  ;; One serialized pair: count=1, name length 5, value length 1, "x-set\00", "v\00".
  (data (i32.const 96) "\01\00\00\00\05\00\00\00\01\00\00\00x-set\00v\00")
  (data (i32.const 128) "no-such-function")
  (data (i32.const 160) "dup-metric")
  (data (i32.const 176) "no-such-queue")
  (data (i32.const 192) "no-such-key")
  (data (i32.const 208) "\ff\ff\ff\ff")

  (func (export "proxy_abi_version_0_2_1"))

  (func (export "proxy_on_memory_allocate") (param $size i32) (result i32)
    (local $p i32)
    (local.set $p (global.get $heap))
    (global.set $heap (i32.and (i32.add (i32.add (global.get $heap) (local.get $size)) (i32.const 7)) (i32.const -8)))
    (local.get $p))

  (func (export "proxy_on_context_create") (param i32 i32))
  (func (export "proxy_on_vm_start") (param i32 i32) (result i32) (i32.const 1))
  (func (export "proxy_on_configure") (param i32 i32) (result i32) (i32.const 1))
  (func (export "proxy_on_done") (param i32) (result i32) (i32.const 1))
  (func (export "proxy_on_delete") (param i32))

  (func $rec (param $idx i32) (param $code i32)
    (i32.store8 (i32.add (i32.const 2048) (local.get $idx)) (i32.add (local.get $code) (i32.const 48))))

  (func (export "proxy_on_request_headers") (param $ctx i32) (param $n i32) (param $eos i32) (result i32)
    (call $rec (i32.const 0) (call $get_log_level (i32.const 1024)))
    (call $rec (i32.const 1) (call $get_time (i32.const 1024)))
    (call $rec (i32.const 2) (call $tick_period (i32.const 0)))
    (call $rec (i32.const 3) (call $map_size (i32.const 0) (i32.const 1024)))
    (call $rec (i32.const 4) (call $map_pairs (i32.const 0) (i32.const 1024) (i32.const 1028)))
    (call $rec (i32.const 5) (call $replace_header (i32.const 0) (i32.const 32) (i32.const 3) (i32.const 40) (i32.const 3)))
    (call $rec (i32.const 6) (call $get_header (i32.const 0) (i32.const 48) (i32.const 9) (i32.const 1024) (i32.const 1028)))
    (call $rec (i32.const 7) (call $get_header (i32.const 99) (i32.const 32) (i32.const 3) (i32.const 1024) (i32.const 1028)))
    (call $rec (i32.const 8) (call $get_property (i32.const 80) (i32.const 12) (i32.const 1024) (i32.const 1028)))
    (call $rec (i32.const 9) (call $set_property (i32.const 64) (i32.const 7) (i32.const 72) (i32.const 2)))
    (call $rec (i32.const 10) (call $get_property (i32.const 64) (i32.const 7) (i32.const 1024) (i32.const 1028)))
    (call $rec (i32.const 11) (call $buffer_status (i32.const 0) (i32.const 1024) (i32.const 1028)))
    (call $rec (i32.const 12) (call $buffer_bytes (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 1024) (i32.const 1028)))
    (call $rec (i32.const 13) (call $get_configuration (i32.const 1024) (i32.const 1028)))
    (call $rec (i32.const 14) (call $get_status (i32.const 1024) (i32.const 1028) (i32.const 1032)))
    (call $rec (i32.const 15) (call $set_effective (i32.const 987654)))
    (call $rec (i32.const 16) (call $set_effective (local.get $ctx)))
    (call $rec (i32.const 17) (call $clear_route_cache))
    (call $rec (i32.const 18) (call $done))
    (call $rec (i32.const 19) (call $set_pairs (i32.const 0) (i32.const 96) (i32.const 20)))
    (call $rec (i32.const 20) (call $set_pairs (i32.const 0) (i32.const 96) (i32.const 5)))
    (call $rec (i32.const 21) (call $map_pairs (i32.const 0) (i32.const 1024) (i32.const 1028)))
    (call $rec (i32.const 22) (call $grpc_cancel (i32.const 4242)))
    (call $rec (i32.const 23) (call $grpc_close (i32.const 4242)))
    (call $rec (i32.const 24) (call $grpc_send (i32.const 4242) (i32.const 40) (i32.const 3) (i32.const 0)))
    (call $rec (i32.const 25) (call $foreign (i32.const 128) (i32.const 16) (i32.const 40) (i32.const 3) (i32.const 1024) (i32.const 1028)))
    (drop (call $define_metric (i32.const 0) (i32.const 160) (i32.const 10) (i32.const 1040)))
    (call $rec (i32.const 26) (call $define_metric (i32.const 1) (i32.const 160) (i32.const 10) (i32.const 1040)))
    (call $rec (i32.const 27) (call $get_metric (i32.const 987654) (i32.const 1056)))
    (call $rec (i32.const 28) (call $dequeue (i32.const 987654) (i32.const 1024) (i32.const 1028)))
    (call $rec (i32.const 29) (call $enqueue (i32.const 987654) (i32.const 40) (i32.const 3)))
    (call $rec (i32.const 30) (call $resolve_queue (i32.const 40) (i32.const 3) (i32.const 176) (i32.const 13) (i32.const 1036)))
    (call $rec (i32.const 31) (call $get_shared (i32.const 192) (i32.const 11) (i32.const 1024) (i32.const 1028) (i32.const 1032)))
    (call $rec (i32.const 32) (call $send_local (i32.const 400) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 208) (i32.const 4) (i32.const -1)))
    (drop (call $add_header (i32.const 0) (i32.const 16) (i32.const 9) (i32.const 2048) (i32.const 33)))
    (i32.const 0))
)
