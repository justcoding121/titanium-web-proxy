;; Faulting guest behaviour, one per request header:
;;  x-trap  -> unreachable (a trap discards the VM)
;;  x-spin  -> an endless loop (the epoch deadline traps it)
;;  x-grow  -> grow memory by 4 MiB and report the outcome in x-grow-result (denied or allowed)
;; Otherwise the request gets x-ok: 1.
(module
  (import "env" "proxy_get_header_map_value" (func $get_header (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "proxy_add_header_map_value" (func $add_header (param i32 i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 2)
  (global $heap (mut i32) (i32.const 8192))
  (data (i32.const 16) "x-trap")
  (data (i32.const 32) "x-spin")
  (data (i32.const 48) "x-grow")
  (data (i32.const 64) "x-grow-result")
  (data (i32.const 80) "denied")
  (data (i32.const 96) "allowed")
  (data (i32.const 112) "x-ok")
  (data (i32.const 120) "1")

  (func (export "proxy_abi_version_0_2_1"))
  (func (export "proxy_on_memory_allocate") (param $size i32) (result i32)
    (local $p i32)
    (local.set $p (global.get $heap))
    (global.set $heap (i32.and (i32.add (i32.add (global.get $heap) (local.get $size)) (i32.const 7)) (i32.const -8)))
    (local.get $p))
  (func (export "proxy_on_context_create") (param i32 i32))
  (func (export "proxy_on_vm_start") (param i32 i32) (result i32) (i32.const 1))
  (func (export "proxy_on_configure") (param i32 i32) (result i32) (i32.const 1))

  (func $has (param $key i32) (param $len i32) (result i32)
    (i32.eqz (call $get_header (i32.const 0) (local.get $key) (local.get $len) (i32.const 1024) (i32.const 1028))))

  (func (export "proxy_on_request_headers") (param $ctx i32) (param $n i32) (param $eos i32) (result i32)
    (if (call $has (i32.const 16) (i32.const 6)) (then unreachable))
    (if (call $has (i32.const 32) (i32.const 6)) (then (loop $spin (br $spin))))
    (if (call $has (i32.const 48) (i32.const 6))
      (then
        (if (i32.eq (memory.grow (i32.const 64)) (i32.const -1))
          (then (drop (call $add_header (i32.const 0) (i32.const 64) (i32.const 13) (i32.const 80) (i32.const 6))))
          (else (drop (call $add_header (i32.const 0) (i32.const 64) (i32.const 13) (i32.const 96) (i32.const 7)))))
        (return (i32.const 0))))
    (drop (call $add_header (i32.const 0) (i32.const 112) (i32.const 4) (i32.const 120) (i32.const 1)))
    (i32.const 0))
)
