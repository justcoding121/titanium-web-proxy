<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Titanium.Web.Proxy.UnitTests\StrongNameKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.9.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.9.3" />
    <PackageReference Include="Avalonia" Version="11.2.8" />
    <PackageReference Include="Avalonia.Headless" Version="11.2.8" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- In-process Kestrel HTTP/2 origin for the throttle delivery gate tests. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- HTTP/3 origin (QuicListener) and the test certificate authority, shared with the Core integration tests. -->
    <Compile Include="..\Titanium.Web.Proxy.IntegrationTests\Helpers\QuicHttp3Helpers.cs" Link="Shared\QuicHttp3Helpers.cs" />
    <Compile Include="..\Titanium.Web.Proxy.IntegrationTests\Setup\TestCertificateAuthority.cs" Link="Shared\TestCertificateAuthority.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Titanium.Inspector\Titanium.Inspector.csproj" />
  </ItemGroup>
</Project>
