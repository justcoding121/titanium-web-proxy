<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Per project invocation. The full solution is run one project at a time. -->
    <TestSessionTimeout>5400000</TestSessionTimeout>
    <EnvironmentVariables>
      <TITANIUM_SKIP_ROOT_STORE_UI>1</TITANIUM_SKIP_ROOT_STORE_UI>
      <TITANIUM_NO_ELEVATE>1</TITANIUM_NO_ELEVATE>
    </EnvironmentVariables>
  </RunConfiguration>
  <MSTest>
    <!-- Ceiling for tests that do not set [Timeout]. A test attribute still wins. -->
    <TestTimeout>300000</TestTimeout>
  </MSTest>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage" uri="datacollector://Microsoft/CodeCoverage/2.0">
        <Configuration>
          <CodeCoverage>
            <!-- Attribute titanium process E2E (and other child hosts) to product assemblies. -->
            <CollectFromChildProcesses>True</CollectFromChildProcesses>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
