<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>StrongNameKey.snk</AssemblyOriginatorKeyFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.9.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.9.3" />
  </ItemGroup>
  
  <!-- The CLI is unsigned and this project is strong-named, so the self-contained exposition sources are linked in
       to drive the real internal ProxyMetrics.RecordRequest through them. -->
  <ItemGroup>
    <Compile Include="..\..\src\Titanium.Cli\Admin\MetricsListener.cs" Link="Admin\MetricsListener.cs" />
    <Compile Include="..\..\src\Titanium.Cli\Admin\MetricsExposition.cs" Link="Admin\MetricsExposition.cs" />
    <Compile Include="..\..\src\Titanium.Cli\Admin\PrometheusTextWriter.cs" Link="Admin\PrometheusTextWriter.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Caching\rfc9111-vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Titanium.Web.Proxy\Titanium.Web.Proxy.csproj" />
  </ItemGroup>

</Project>
