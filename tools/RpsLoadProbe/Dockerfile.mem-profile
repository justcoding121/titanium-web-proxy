# Linux memory-profile image: .NET 10 SDK + libmsquic + dump tools.
# Diagnosis only — publishable medians stay on GHA.
# Build: docker build -f tools/RpsLoadProbe/Dockerfile.mem-profile -t twp-mem-linux tools/RpsLoadProbe
FROM mcr.microsoft.com/dotnet/sdk:10.0

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
    && . /etc/os-release \
    && curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
         "https://packages.microsoft.com/config/${ID}/${VERSION_ID}/packages-microsoft-prod.deb" \
         -o /tmp/packages-microsoft-prod.deb \
    && dpkg -i /tmp/packages-microsoft-prod.deb \
    && rm -f /tmp/packages-microsoft-prod.deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends libmsquic \
    && rm -rf /var/lib/apt/lists/*

RUN dotnet tool install -g dotnet-gcdump --version 9.* \
    && dotnet tool install -g dotnet-dump --version 9.*
ENV PATH="${PATH}:/root/.dotnet/tools"

WORKDIR /src
ENTRYPOINT ["/bin/bash"]
