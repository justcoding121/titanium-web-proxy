<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Server GC: console apps default to workstation GC; terminate arms need multi-core heap. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\src\Titanium.Web.Proxy\StrongNameKey.snk</AssemblyOriginatorKeyFile>
    <!--
      Measurement harness only: kept in the solution so it compiles under warnaserror,
      but never executed from the per-PR workflow (see rps-saturation.yml for manual Linux/Windows runs).
    -->
    <NoWarn>$(NoWarn);TWP001;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Titanium.Web.Proxy\Titanium.Web.Proxy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\echo.proto" GrpcServices="Both" />
  </ItemGroup>

  <!-- Local macOS: copy MsQuic beside the apphost so Http3NativeBootstrap can reexec with DYLD. -->
  <Target Name="CopyMacHttp3Natives" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)..\packaging\copy-http3-natives-osx.sh&quot; &quot;$(TargetDir)&quot;"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low" />
  </Target>

  <ItemGroup>
    <Compile Remove="results\**\*" />
    <None Remove="results\**\*" />
    <Content Remove="results\**\*" />
    <EmbeddedResource Remove="results\**\*" />
  </ItemGroup>
</Project>
