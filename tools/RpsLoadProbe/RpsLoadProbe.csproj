<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Server GC: console apps default to workstation GC; terminate arms need multi-core heap. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\src\Titanium.Web.Proxy\StrongNameKey.snk</AssemblyOriginatorKeyFile>
    <!--
      Measurement harness only: kept in the solution so it compiles under warnaserror,
      but never executed from the per-PR workflow (see rps-saturation.yml for manual Linux runs).
    -->
    <NoWarn>$(NoWarn);TWP001;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Titanium.Web.Proxy\Titanium.Web.Proxy.csproj" />
  </ItemGroup>

</Project>
