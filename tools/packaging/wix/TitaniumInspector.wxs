<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Titanium Inspector"
           Manufacturer="justcoding121"
           Version="$(var.ProductVersion)"
           UpgradeCode="A7C3E91B-4F2D-4A8E-9B1C-6D5E8F0A2B3C"
           Scope="perMachine">
    <!-- New ProductCode each build, shared UpgradeCode. Same ProductVersion (beta or stable)
         is an upgrade so the last MSI that ran is the only install; a lower version is blocked. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Titanium Inspector is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/justcoding121/titanium-web-proxy" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Titanium Inspector" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!-- Close running Inspector before overwriting locked files (manual MSI upgrade). -->
    <util:CloseApplication Id="CloseInspector"
                           Target="TitaniumInspector.exe"
                           CloseMessage="yes"
                           RebootPrompt="no"
                           Timeout="10" />

    <!-- Launch the installed apphost (type 18). WixShellExec can reopen this MSI when the
         formatted path is empty or resolves to the source folder. -->
    <CustomAction Id="LaunchApplication"
                  FileRef="InspectorExe"
                  ExeCommand=""
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <Feature Id="Main" Title="Titanium Inspector" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication"
               Order="2"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Titanium Inspector" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Titanium Inspector" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.PayloadDir)\**">
        <Exclude Files="!(bindpath.PayloadDir)\TitaniumInspector.exe" />
      </Files>
      <Component Id="InspectorExecutable">
        <File Id="InspectorExe" Source="!(bindpath.PayloadDir)\TitaniumInspector.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <Component Id="StartMenuShortcut" Directory="INSTALLFOLDER" Guid="B1D4E82A-5C3E-4B9F-8A2D-7E6F9A1B3C4D">
      <Shortcut Id="AppShortcut"
                Directory="AppMenuFolder"
                Name="Titanium Inspector"
                Target="[#InspectorExe]"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
      <!-- Per-machine package: HKLM keypath. HKCU keypaths can start a second UI session. -->
      <RegistryValue Root="HKLM"
                     Key="Software\justcoding121\TitaniumInspector"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
    <Component Id="DesktopShortcut" Directory="INSTALLFOLDER" Guid="C2E5F93B-6D4F-5CA0-9B3E-8F7A0B2C4D5E">
      <Shortcut Id="DesktopAppShortcut"
                Directory="DesktopFolder"
                Name="Titanium Inspector"
                Target="[#InspectorExe]"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RegistryValue Root="HKLM"
                     Key="Software\justcoding121\TitaniumInspector"
                     Name="desktop"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
