<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Titanium.Inspector.InstallSmoke</RootNamespace>
    <!-- FlaUI is a .NET Framework package. The Windows UI file is the only consumer. -->
    <NoWarn>$(NoWarn);CA1416;NU1701</NoWarn>
  </PropertyGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <Reference Include="Accessibility" Condition="Exists('$(windir)\Microsoft.NET\Framework64\v4.0.30319\Accessibility.dll')">
      <HintPath>$(windir)\Microsoft.NET\Framework64\v4.0.30319\Accessibility.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Remove="UiClicks.Unix.cs" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="UiClicks.Windows.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\InspectorDesktopProbe\Shared\Titanium.Inspector.DesktopProbe.Shared.csproj" />
  </ItemGroup>
</Project>
