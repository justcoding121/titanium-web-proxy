**/obj/
**/node_modules/
.git/
.github/
.tmp/
.tmp-rps/
artifacts/
BenchmarkDotNet.Artifacts/
coverage/
TestResults/
tmp/
website/
wiki/
docs/
examples/
benchmarks/
tests/
tools/*
!tools/packaging/
!tools/packaging/**
!tools/scripting/
!tools/scripting/**
tools/packaging/.cache/
*.log
