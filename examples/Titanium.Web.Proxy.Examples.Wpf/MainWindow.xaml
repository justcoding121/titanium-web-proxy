<Window x:Class="Titanium.Web.Proxy.Examples.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Titanium Web Proxy"
        Icon="pack://application:,,,/app.ico"
        Height="500" Width="1000" WindowState="Maximized"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="720" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="360" MinWidth="280" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <GridSplitter Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch" />
        <ListView Grid.Column="0" Grid.Row="0" HorizontalAlignment="Stretch" ItemsSource="{Binding Sessions}"
                  SelectedItem="{Binding SelectedSession}"
                  KeyDown="ListViewSessions_OnKeyDown"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Result" Width="55" DisplayMemberBinding="{Binding StatusCode}" />
                    <GridViewColumn Header="Client↔Server" Width="130" DisplayMemberBinding="{Binding Protocol}" />
                    <GridViewColumn Header="Host" Width="140" DisplayMemberBinding="{Binding Host}" />
                    <GridViewColumn Header="Url" Width="160" DisplayMemberBinding="{Binding Url}" />
                    <GridViewColumn Header="BodySize" Width="70" DisplayMemberBinding="{Binding BodySize}" />
                    <GridViewColumn Header="Process" Width="100" DisplayMemberBinding="{Binding Process}" />
                    <GridViewColumn Header="SentBytes" Width="75" DisplayMemberBinding="{Binding SentDataCount}" />
                    <GridViewColumn Header="ReceivedBytes" Width="90" DisplayMemberBinding="{Binding ReceivedDataCount}" />
                    <GridViewColumn Header="ClientRemoteEndPoint" Width="140" DisplayMemberBinding="{Binding ClientRemoteEndPoint}" />
                    <GridViewColumn Header="ClientConnectionId" Width="120" DisplayMemberBinding="{Binding ClientConnectionId}" />
                    <GridViewColumn Header="ServerConnectionId" Width="120" DisplayMemberBinding="{Binding ServerConnectionId}" />
                </GridView>
            </ListView.View>
        </ListView>
        <TabControl Grid.Column="2" Grid.Row="0">
            <TabItem Header="Session">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TextBoxRequest" Grid.Row="0" />
                    <TabControl Grid.Row="1">
                        <TabItem Header="Text">
                            <TextBox x:Name="TextBoxResponse" />
                        </TabItem>
                        <TabItem Header="Image">
                            <Image x:Name="ImageResponse" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Stretch="None" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="4,6">
            <ToggleButton x:Name="ToggleSystemProxy" IsChecked="True" Content="System Proxy" Margin="0,0,24,0"
                          Padding="10,2" Click="ButtonProxyOnOff_OnClick"
                          ToolTip="Register or restore Windows system proxy settings" />
            <TextBlock Text="TCP clients:" Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ClientConnectionCount}" Margin="6,0,16,0" VerticalAlignment="Center" />
            <TextBlock Text="Servers (all):" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ServerConnectionCount}" Margin="6,0,16,0" VerticalAlignment="Center" />
            <TextBlock Text="QUIC clients:" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Http3ClientConnectionCount}" Margin="6,0,16,0" VerticalAlignment="Center" />
            <TextBlock Text="QUIC servers:" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Http3ServerConnectionCount}" Margin="6,0,16,0" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>